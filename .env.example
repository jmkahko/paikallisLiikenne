# Digitransit API subscription key.
# HUOM: muuttujanimessä EI ole VITE_-prefixiä → avainta ei paketoida
# selainbundleen. Vite-dev-palvelin lukee tämän loadEnv:llä ja injektoi
# proxy-pyyntöjen headeriin. Docker-runtime saa saman avaimen
# environment-muuttujana.
#
# Hanki ilmainen avain: https://portal-api.digitransit.fi/
# Kopioi tämä tiedosto nimellä .env ja täytä avain alle.
DIGITRANSIT_API_KEY=

# Sallittu origin CORS-tarkistukseen (aseta aina tuotannossa).
# PHP-proxy hyväksyy vain pyynnöt tästä osoitteesta. Vertailu on tarkka:
# protokolla mukaan, ei kauttaviivaa loppuun. Tyhjä = tarkistus pois päältä.
# Dev-palvelin (npm run dev) ei aja PHP:tä eikä käytä tätä arvoa.
# Esim. tuotannossa: https://minunsivuni.fi
# Esim. Dockerissa:  http://localhost:8080
ALLOWED_ORIGIN=

# Digitransitin GraphQL-rajapinnan osoite (pakollinen).
# Waltti/Tampere: https://api.digitransit.fi/routing/v2/waltti/gtfs/v1/
DIGITRANSIT_ENDPOINT=

# MySQL-tietokanta käyttöliittymän teksteille (api/texts.php).
# Docker luo näillä arvoilla tietokannan ja käyttäjän ensimmäisellä
# käynnistyksellä ja ajaa db/*.sql-tiedostot. Palvelimen nimi (DB_HOST) on
# docker-compose.yml:ssä kiinteästi "db". Web-hotellissa arvot annetaan
# config.php:ssä (db_host, db_name, db_user, db_password) tai env-muuttujina.
# Devissä (npm run dev) tekstit haetaan Docker-containerista, joten
# `docker compose up` pitää olla käynnissä.
DB_NAME=
DB_USER=
DB_PASSWORD=
