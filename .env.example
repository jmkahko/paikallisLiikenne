# Digitransit API subscription key.
# HUOM: muuttujanimessä EI ole VITE_-prefixiä → avainta ei paketoida
# selainbundleen. Vite-dev-palvelin lukee tämän loadEnv:llä ja injektoi
# proxy-pyyntöjen headeriin. Docker-runtime saa saman avaimen
# environment-muuttujana.
#
# Hanki ilmainen avain: https://portal-api.digitransit.fi/
# Kopioi tämä tiedosto nimellä .env ja täytä avain alle.
DIGITRANSIT_API_KEY=

# Sallittu origin CORS-tarkistukseen (pakollinen).
# PHP-proxy hyväksyy vain pyynnöt tästä osoitteesta.
# Esim. tuotannossa: https://minunsivuni.fi
# Esim. Dockerissa:  http://localhost:8080
ALLOWED_ORIGIN=

# Digitransitin GraphQL-rajapinnan osoite (pakollinen).
# Waltti/Tampere: https://api.digitransit.fi/routing/v2/waltti/gtfs/v1/
DIGITRANSIT_ENDPOINT=
