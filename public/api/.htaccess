# Estä config.php:n ja sen mallin suora lataus selaimella.
# Apache 2.4+ käyttää Require-direktiiviä; vanhat 2.2 / LiteSpeed -ympäristöt
# nojaavat Order/Deny-direktiiveihin — pidetään molemmat yhteensopivuuden
# vuoksi.
<FilesMatch "^config(\.example)?\.php$">
    Require all denied

    Order allow,deny
    Deny from all
</FilesMatch>
